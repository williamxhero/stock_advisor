{
  "openapi": "3.1.0",
  "info": {"title": "Trading MemoryHub", "version": "1.0.0"},
  "paths": {
    "/health": {"get": {"responses": {"200": {"description": "Capability health"}}}},
    "/v1/episodes": {"post": {"responses": {
      "200": {"description": "Immutable append receipt"},
      "409": {"description": "Same source event with different content"}
    }}},
    "/v1/snapshots": {"post": {"responses": {"200": {"description": "Frozen ledger watermark"}}}},
    "/v1/snapshots/{snapshot_id}/search": {"post": {"responses": {"200": {"description": "Policy-filtered memory cards"}}}},
    "/v1/snapshots/{snapshot_id}/expand": {"post": {"responses": {"200": {"description": "Visible immutable episode"}}}},
    "/v1/snapshots/{snapshot_id}/related": {"post": {"responses": {"200": {"description": "Visible correction and outcome links"}}}}
  }
}
