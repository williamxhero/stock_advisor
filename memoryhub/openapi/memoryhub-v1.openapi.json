{
  "openapi": "3.1.0",
  "info": {"title": "Trading MemoryHub", "version": "1.0.0"},
  "paths": {
    "/health": {"get": {"responses": {"200": {"description": "Capability health"}}}},
    "/admin/": {"get": {"responses": {"200": {"description": "Packaged read-only MemoryHub operator workspace"}}}},
    "/v1/admin/memory-spaces": {"get": {"responses": {"200": {"description": "Read-only memory-space summaries ordered by recent activity"}}}},
    "/v1/admin/episodes": {"get": {"responses": {"200": {"description": "Cursor-paged and filtered immutable episodes"}}}},
    "/v1/admin/episodes/{episode_id}": {"get": {"responses": {"200": {"description": "Episode, non-authoritative derivation and relations"}}}},
    "/v1/admin/episodes/{episode_id}/source": {"get": {"responses": {"200": {"description": "Explicit on-demand immutable authority hydration"}, "409": {"description": "Authority content failed immutable hash verification"}}}},
    "/v1/admin/episodes/export": {"get": {"responses": {"200": {"description": "Filtered read-only JSON download"}}}},
    "/v1/admin/timeline": {"get": {"responses": {"200": {"description": "Submitted user and published AI message timeline"}}}},
    "/v1/admin/snapshots": {"get": {"responses": {"200": {"description": "Frozen retrieval snapshots"}}}},
    "/v1/admin/retrieval-audits": {"get": {"responses": {"200": {"description": "Operational retrieval audits kept outside memory"}}}},
    "/v1/admin/retrieval-bundles/{bundle_id}": {"get": {"responses": {"200": {"description": "Immutable retrieval bundle replay"}}}},
    "/v1/episodes": {"post": {"responses": {
      "200": {"description": "Immutable append receipt"},
      "409": {"description": "Same source event with different content"}
    }}},
    "/v1/episodes/batch": {"post": {"responses": {"200": {"description": "Per-record receipts and conflicts for idempotent migration"}}}},
    "/v1/snapshots": {"post": {"responses": {"200": {"description": "Frozen ledger watermark"}}}},
    "/v1/snapshots/{snapshot_id}/search": {"post": {"responses": {"200": {"description": "Policy-filtered memory cards"}}}},
    "/v1/snapshots/{snapshot_id}/retrieve": {"post": {"responses": {"200": {"description": "Versioned, replayable MemoryBundle with separate audit reference"}}}},
    "/v1/snapshots/{snapshot_id}/expand": {"post": {"responses": {"200": {"description": "Visible immutable episode"}}}},
    "/v1/snapshots/{snapshot_id}/related": {"post": {"responses": {"200": {"description": "Visible correction and outcome links"}}}},
    "/v1/memory-spaces/{memory_space_id}/timeline": {"post": {"responses": {"200": {"description": "Submitted and published message timeline"}}}},
    "/v1/memory-spaces/{memory_space_id}/export": {"post": {"responses": {"200": {"description": "Human and machine rebuildable private-space export"}}}},
    "/v1/memory-spaces/{memory_space_id}/clear/prepare": {"post": {"responses": {"200": {"description": "Second-confirmation token bound to a fresh export"}}}},
    "/v1/memory-spaces/{memory_space_id}/clear": {"post": {"responses": {"200": {"description": "Idempotent whole-space clear receipt"}}}},
    "/v1/retrieval/audits/{audit_id}": {"post": {"responses": {"200": {"description": "Operational retrieval audit; never timeline memory"}}}},
    "/v1/retrieval/bundles/{bundle_id}": {"post": {"responses": {"200": {"description": "Immutable MemoryBundle replay"}}}},
    "/v1/retrieval/query-sets": {"post": {"responses": {"200": {"description": "Frozen qualification query set"}}}},
    "/v1/retrieval/evaluations": {"post": {"responses": {"200": {"description": "Multi-dimensional candidate report"}}}},
    "/v1/retrieval/promotions": {"post": {"responses": {"200": {"description": "Explicit promotion of a qualified candidate"}}}}
  }
}
