{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRoleSpec/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "role", "stage", "visibility", "status", "decision_effect", "propositions", "evidence_refs", "counterevidence_refs", "risks", "unknowns", "provenance", "permissions"],
  "properties": {
    "contract": {"const": "AgentRoleSpec/v1"},
    "version": {"const": 1},
    "role": {"enum": ["fundamental", "market_structure", "news_event", "propagation_sentiment", "bull", "bear", "risk", "coordinator"]},
    "stage": {"enum": ["m0_research", "m1_research", "m2", "outcome_research", "chat_research"]},
    "visibility": {"const": "internal"},
    "status": {"enum": ["succeeded", "partial", "blocked", "failed", "unknown"]},
    "decision_effect": {"enum": ["evidence_only", "support", "oppose", "block", "coordinate", "unknown"]},
    "propositions": {"type": "array", "items": {"$ref": "#/$defs/proposition"}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "counterevidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "unknowns": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "object", "required": ["input_sha256"], "properties": {"input_sha256": {"type": "string", "minLength": 1}}},
    "permissions": {"type": "object", "required": ["write_permissions"], "properties": {"write_permissions": {"const": []}, "read_permissions": {"type": "array"}}}
  },
  "$defs": {
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "kind", "evidence_refs", "counterevidence_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "kind": {"enum": ["conclusion", "claim", "reasoning", "risk", "unknown"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "counterevidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
