{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of", "spoken_summary", "sources", "coverage", "critical_gaps", "conflicts", "high_impact_events"],
  "properties": {
    "as_of": {"type": "string"},
    "spoken_summary": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title", "fact_as_of", "published_at", "source_family", "upstream_id", "tool_observation_id", "result_item_hash", "excerpt", "factual_reliability", "market_propagation"],
        "properties": {
          "url": {"type": "string"},
          "title": {"type": "string"},
          "fact_as_of": {"type": ["string", "null"]},
          "published_at": {"type": ["string", "null"]},
          "source_family": {"enum": ["official", "primary", "media", "market_data", "forum", "other"]},
          "upstream_id": {"type": "string"},
          "tool_observation_id": {"type": "string"},
          "result_item_hash": {"type": "string"},
          "excerpt": {"type": "string"},
          "factual_reliability": {"type": ["string", "null"]},
          "market_propagation": {"type": ["string", "null"]}
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_key", "status", "evidence_urls", "reason"],
        "properties": {
          "requirement_key": {"type": "string"},
          "status": {"enum": ["covered", "checked_no_change", "missing", "stale", "failed"]},
          "evidence_urls": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    },
    "critical_gaps": {"type": "array", "items": {"type": "string"}},
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim", "competing_evidence", "materiality"],
        "properties": {
          "claim": {"type": "string"},
          "competing_evidence": {"type": "array", "items": {"type": "string"}},
          "materiality": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "high_impact_events": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["summary", "scope", "materiality", "evidence_urls"],
        "properties": {
          "summary": {"type": "string"},
          "scope": {"enum": ["market", "theme", "portfolio"]},
          "materiality": {"enum": ["low", "medium", "high"]},
          "evidence_urls": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
