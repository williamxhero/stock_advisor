{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DebateSpec/v1 input",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "stage", "visibility", "evidence_snapshot_refs", "role_input_refs", "provenance", "permissions"],
  "properties": {
    "contract": {"const": "DebateSpec/v1"}, "version": {"const": 1},
    "stage": {"type": "string", "minLength": 1}, "visibility": {"const": "internal"},
    "evidence_snapshot_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "role_input_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "object", "required": ["as_of"], "properties": {"cycle_id": {}, "packet_sha256": {}, "as_of": {"type": "string", "minLength": 1}}},
    "permissions": {"type": "object", "required": ["write_permissions"], "properties": {"write_permissions": {"const": []}, "read_permissions": {"type": "array"}}}
  }
}
