{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LessonFrozenWindow/v1 raw bounded market observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "cycle_id", "subject", "horizon", "reference_at", "window_end", "reference_price", "reference_benchmark_price", "benchmark", "market_regime", "bars"],
  "properties": {
    "contract": {"const": "LessonFrozenWindow/v1"},
    "version": {"const": 1},
    "cycle_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "horizon": {"type": "string", "minLength": 1},
    "reference_at": {"type": "string", "minLength": 1},
    "window_end": {"type": "string", "minLength": 1},
    "reference_price": {"type": "number", "exclusiveMinimum": 0},
    "reference_benchmark_price": {"type": "number", "exclusiveMinimum": 0},
    "benchmark": {"type": "string", "minLength": 1},
    "market_regime": {
      "type": "object", "additionalProperties": false,
      "required": ["index_trend", "breadth", "turnover_change", "volatility"],
      "properties": {
        "index_trend": {"type": "number"},
        "breadth": {"type": "number", "minimum": 0, "maximum": 1},
        "turnover_change": {"type": "number"},
        "volatility": {"type": "number", "minimum": 0}
      }
    },
    "bars": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["start_at", "end_at", "close", "benchmark_close", "low", "high"],
        "properties": {
          "start_at": {"type": "string", "minLength": 1},
          "end_at": {"type": "string", "minLength": 1},
          "close": {"type": "number", "exclusiveMinimum": 0},
          "benchmark_close": {"type": "number", "exclusiveMinimum": 0},
          "low": {"type": "number", "exclusiveMinimum": 0},
          "high": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
