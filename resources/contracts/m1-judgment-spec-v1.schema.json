{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M1JudgmentResult/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "version", "spec_contract", "stage", "state", "source_result_version",
    "input", "source_output", "product", "permissions", "quantresearch", "provenance", "sha256"
  ],
  "properties": {
    "contract": {"type": "string", "const": "M1JudgmentResult/v1"},
    "version": {"type": "integer", "const": 1},
    "spec_contract": {"type": "string", "const": "M1JudgmentSpec/v1"},
    "stage": {"type": "string", "const": "m1_judgment"},
    "state": {"type": "string", "const": "qualified"},
    "source_result_version": {"type": "integer", "const": 5},
    "input": {"$ref": "#/$defs/input"},
    "source_output": {"type": "object"},
    "product": {"$ref": "#/$defs/product"},
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["write_permissions"],
      "properties": {"write_permissions": {"type": "array", "const": []}}
    },
    "quantresearch": {
      "type": "object", "additionalProperties": false,
      "required": ["access", "write_permissions"],
      "properties": {
        "access": {"type": "string", "const": "read_only"},
        "write_permissions": {"type": "array", "const": []}
      }
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "input": {
      "type": "object", "additionalProperties": false,
      "required": [
        "contract", "version", "stage", "source_packet", "evidence_snapshot", "evidence_refs",
        "mandate_reference", "boundary", "permissions", "quantresearch", "provenance"
      ],
      "properties": {
        "contract": {"type": "string", "const": "M1JudgmentSpec/v1"},
        "version": {"type": "integer", "const": 1},
        "stage": {"type": "string", "const": "m1_judgment"},
        "source_packet": {"type": "object"},
        "evidence_snapshot": {"$ref": "#/$defs/evidence_snapshot"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "mandate_reference": {
          "type": "object", "additionalProperties": false,
          "required": ["contract", "sha256"],
          "properties": {
            "contract": {"type": "string", "const": "MandateSpec/v1"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "boundary": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed_inputs", "forbidden_inputs", "h0_visible", "m2_visible", "published_chat_after_cutoff_visible"],
          "properties": {
            "allowed_inputs": {"type": "array", "items": {"type": "string"}},
            "forbidden_inputs": {"type": "array", "items": {"type": "string"}},
            "h0_visible": {"type": "boolean", "const": false},
            "m2_visible": {"type": "boolean", "const": false},
            "published_chat_after_cutoff_visible": {"type": "boolean", "const": false}
          }
        },
        "permissions": {"$ref": "#/$defs/permissions"},
        "quantresearch": {"$ref": "#/$defs/quantresearch"},
        "research_request": {"$ref": "#/$defs/research_request"},
        "research_evidence": {"$ref": "#/$defs/research_evidence"},
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "cycle_id", "as_of", "packet_sha256"],
          "properties": {
            "source": {"type": "string", "const": "runtime"},
            "cycle_id": {"type": "string", "minLength": 1},
            "as_of": {"type": "string", "minLength": 1},
            "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["write_permissions"],
      "properties": {"write_permissions": {"type": "array", "const": []}}
    },
    "quantresearch": {
      "type": "object", "additionalProperties": false,
      "required": ["access", "write_permissions"],
      "properties": {
        "access": {"type": "string", "const": "read_only"},
        "write_permissions": {"type": "array", "const": []}
      }
    },
    "research_request": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "version", "task_key", "as_of", "market_scope", "universe", "research_goal", "baseline_strategy_version", "strategy_package", "research_run_id", "permissions", "sha256"],
      "properties": {
        "contract": {"type": "string", "const": "ResearchEvidenceRequest/v1"},
        "version": {"type": "integer", "const": 1},
        "task_key": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "as_of": {"type": "string", "minLength": 1, "format": "date-time"},
        "market_scope": {"type": "object", "minProperties": 1},
        "universe": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
        "research_goal": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "baseline_strategy_version": {"type": ["string", "null"], "pattern": "\\S"},
        "strategy_package": {"type": ["object", "null"], "minProperties": 1},
        "research_run_id": {"type": ["string", "null"], "pattern": "\\S"},
        "permissions": {"$ref": "#/$defs/quantresearch"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "research_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "version", "research_run_id", "dataset_version", "code_version", "parameter_version", "intervals", "out_of_sample", "cost_assumptions", "risk_metrics", "applicability", "baseline_comparison", "conclusion", "reproducibility", "evidence_refs", "provenance", "permissions", "quantresearch", "sha256"],
      "properties": {
        "contract": {"type": "string", "const": "ResearchEvidence/v1"},
        "version": {"type": "integer", "const": 1},
        "research_run_id": {"type": "string", "minLength": 1},
        "dataset_version": {"type": "string", "minLength": 1},
        "code_version": {"type": "string", "minLength": 1},
        "parameter_version": {"type": "string", "minLength": 1},
        "intervals": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object", "minProperties": 2,
            "required": ["start", "end"],
            "properties": {
              "start": {"anyOf": [{"type": "string", "format": "date"}, {"type": "string", "format": "date-time"}]},
              "end": {"anyOf": [{"type": "string", "format": "date"}, {"type": "string", "format": "date-time"}]}
            }
          }
        },
        "out_of_sample": {"type": "object", "minProperties": 1},
        "cost_assumptions": {"type": "object", "minProperties": 1},
        "risk_metrics": {"type": "object", "minProperties": 1},
        "applicability": {"type": "object", "minProperties": 1},
        "baseline_comparison": {"type": "object", "minProperties": 1},
        "conclusion": {"type": "object", "minProperties": 1},
        "reproducibility": {"type": "object", "minProperties": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}, "uniqueItems": true},
        "provenance": {"type": "object", "required": ["source", "as_of", "known_at", "artifact_ref", "request_sha256"], "properties": {
          "source": {"type": "string", "const": "quantresearch"},
          "as_of": {"type": "string", "minLength": 1},
          "known_at": {"type": "string", "minLength": 1},
          "artifact_ref": {"type": "string", "minLength": 1},
          "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }, "additionalProperties": false},
        "permissions": {"$ref": "#/$defs/quantresearch"},
        "quantresearch": {"$ref": "#/$defs/quantresearch"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "cycle_id", "as_of", "packet_sha256", "input_sha256", "output_sha256", "attempt_id"],
      "properties": {
        "source": {"type": "string", "const": "runtime"},
        "cycle_id": {"type": "string", "minLength": 1},
        "as_of": {"type": "string", "minLength": 1},
        "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "attempt_id": {"type": ["string", "null"]}
      }
    },
    "evidence_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "snapshot_id", "cycle_id", "as_of", "schema_version", "content_hash", "source_watermarks", "included_sources", "version"],
      "properties": {
        "contract": {"type": "string", "const": "EvidenceSnapshotSpec/v1"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "cycle_id": {"type": "string", "minLength": 1},
        "as_of": {"type": "string", "minLength": 1},
        "schema_version": {"type": "integer", "const": 1},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_watermarks": {"type": "object"},
        "included_sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "version": {"type": "integer", "minimum": 1},
        "parent_snapshot_id": {"type": "string", "minLength": 1}
      }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["conclusion_claims", "supporting_evidence", "counter_evidence", "risks", "invalidation_conditions", "unknowns", "confidence_state"],
      "properties": {
        "conclusion_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conclusion"}},
        "supporting_evidence": {"type": "array", "items": {"type": "object"}},
        "counter_evidence": {"type": "array", "items": {"type": "object"}},
        "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
        "invalidation_conditions": {"type": "array", "items": {"type": "object"}},
        "unknowns": {"type": "object"},
        "confidence_state": {
          "type": "object", "additionalProperties": false,
          "required": ["level", "qualified"],
          "properties": {
            "level": {"type": "string", "enum": ["low", "medium", "high"]},
            "qualified": {"type": "boolean", "const": true}
          }
        }
      }
    },
    "conclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["claim", "direction", "horizon", "evidence_refs"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "enum": ["bullish", "bearish", "neutral", "avoid"]},
        "horizon": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "text", "evidence_refs"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
