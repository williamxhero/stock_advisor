{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MandateSpec/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "task_key", "stage", "goal", "constraints", "required_skills", "optional_skills", "memory_scope", "quantresearch_permission", "risk_level", "visibility", "provenance", "permissions", "sha256"],
  "properties": {
    "contract": {"const": "MandateSpec/v1"},
    "version": {"const": 1},
    "task_key": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "required_skills": {"$ref": "#/$defs/skillSet"},
    "optional_skills": {"$ref": "#/$defs/skillSet"},
    "memory_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "memory_space_id", "allowed_stages", "allowed_kinds", "max_results", "as_of_bounded"],
      "properties": {
        "version": {"const": 1}, "memory_space_id": {"type": "string", "minLength": 1},
        "allowed_stages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "allowed_kinds": {"type": "array", "items": {"type": "string"}},
        "max_results": {"type": "integer", "minimum": 1, "maximum": 80}, "as_of_bounded": {"const": true}
      }
    },
    "quantresearch_permission": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "enabled", "access", "scope", "write_permissions"],
      "properties": {
        "version": {"const": 1}, "enabled": {"type": "boolean"}, "access": {"const": "read_only"},
        "scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "write_permissions": {"const": []}
      }
    },
    "risk_level": {"type": "object", "additionalProperties": false, "required": ["version", "value"], "properties": {"version": {"const": 1}, "value": {"enum": ["low", "medium", "high", "critical"]}}},
    "visibility": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "h0_visible", "human_directional_signal_visible", "published_chat_after_cutoff_visible"],
      "properties": {"version": {"const": 1}, "h0_visible": {"type": "boolean"}, "human_directional_signal_visible": {"const": false}, "published_chat_after_cutoff_visible": {"const": false}}
    },
    "provenance": {"type": "object", "additionalProperties": false, "required": ["contract", "source", "as_of"], "properties": {"contract": {"const": "MandateProvenance/v1"}, "source": {"const": "runtime"}, "as_of": {"type": "string", "minLength": 1}, "task_profile_id": {"type": ["string", "null"]}, "task_profile_version": {"type": ["integer", "null"]}}},
    "permissions": {"type": "object", "additionalProperties": false, "required": ["write_permissions"], "properties": {"write_permissions": {"const": []}}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [{
    "if": {"properties": {"stage": {"pattern": "^m1(?:_|$)"}}},
    "then": {"properties": {"visibility": {"properties": {"h0_visible": {"const": false}}}}}
  }],
  "$defs": {
    "skillSet": {
      "type": "object", "additionalProperties": false, "required": ["version", "items"],
      "properties": {
        "version": {"const": 1},
        "items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["skill_id", "version", "scope"], "properties": {"skill_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}}}}
      }
    }
  }
}
