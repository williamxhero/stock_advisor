<Window x:Class="AITradingCompanion.Desktop.Views.EvaluationObservatoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="评测与进化中心" Width="920" Height="680" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}" />
        <DataTemplate x:Key="ObservatoryCardTemplate">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="ObservatoryList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemTemplate" Value="{StaticResource ObservatoryCardTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="评测与进化中心" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="只读展示运行事实、质量结果和治理建议；策略变化仍由治理链路应用。"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Button Content="刷新" Click="RefreshButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7" />
        </Grid>
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="运行状况"><ListBox ItemsSource="{Binding RuntimeHealth}" Style="{StaticResource ObservatoryList}" Margin="0,14,0,0" /></TabItem>
            <TabItem Header="研究质量"><ListBox ItemsSource="{Binding ResearchQuality}" Style="{StaticResource ObservatoryList}" Margin="0,14,0,0" /></TabItem>
            <TabItem Header="判断结果"><ListBox ItemsSource="{Binding JudgmentOutcomes}" Style="{StaticResource ObservatoryList}" Margin="0,14,0,0" /></TabItem>
            <TabItem Header="进化实验"><ListBox ItemsSource="{Binding EvolutionExperiments}" Style="{StaticResource ObservatoryList}" Margin="0,14,0,0" /></TabItem>
        </TabControl>
    </Grid>
</Window>
