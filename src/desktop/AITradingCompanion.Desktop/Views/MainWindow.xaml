<Window x:Class="AITradingCompanion.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AITradingCompanion.Desktop.ViewModels"
        Title="AI交易伙伴"
        Icon="/Assets/app-icon.ico"
        Width="1180" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}" />
        <Style x:Key="RecordListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Container" Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Container" Property="Background" Value="#1C2A41" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Container" Property="Background" Value="#223552" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="{Binding TodayText}" FontSize="29" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                <Button Content="任务管理" Click="TaskButton_Click" Padding="12,6" Margin="12,0,0,0" />
                <Button Content="工具管理" Click="ToolManagerButton_Click" Padding="12,6" Margin="12,0,0,0" />
                <Button Content="评测与进化中心" Click="ObservatoryButton_Click" Padding="12,6" Margin="12,0,0,0" />
                <Button Content="持仓" Click="PortfolioButton_Click" Padding="12,6" Margin="12,0,0,0" />
                <Button Content="记忆" Click="MemoryButton_Click" Padding="12,6" Margin="12,0,0,0" />
                <Button Command="{Binding ToggleStartupCommand}" Padding="12,6" Margin="12,0,0,0">
                    <TextBlock><Run Text="开机启动：" /><Run Text="{Binding StartupStateText, Mode=OneWay}" /></TextBlock>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                <TabControl SelectedIndex="{Binding SelectedSectionIndex}" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                            <Setter Property="Margin" Value="0,0,2,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Header" Background="Transparent" CornerRadius="8" Padding="6,7">
                                            <ContentPresenter ContentSource="Header" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Header" Property="Background" Value="#223552" />
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Header" Property="Background" Value="#1C2A41" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem>
                        <TabItem.Header>
                            <TextBlock FontSize="14" FontWeight="SemiBold"><Run Text="今日列表  " /><Run Text="{Binding CompletedCount, Mode=OneWay}" /><Run Text="/5" /></TextBlock>
                        </TabItem.Header>
                        <ListBox Margin="0,14,0,0" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RecordListItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource BlueBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,4,0,0" ToolTip="{Binding RuntimeError}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasRuntimeProblem}" Value="True"><Setter Property="Foreground" Value="#FF7B8B" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource BlueBrush}" Margin="0,0,7,0"
                                                     Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="✓" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold"
                                                       Visibility="{Binding ShowCompletedIndicator, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="!" Foreground="#FF7B8B" FontSize="15" FontWeight="Bold"
                                                       Visibility="{Binding HasRuntimeProblem, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="历史列表" />
                        </TabItem.Header>
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索任务、摘要、正文、备注或task_key" />
                            <TreeView Grid.Row="1" ItemsSource="{Binding HistoryByDate}" Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource PrimaryTextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectedItemChanged="HistoryTree_SelectedItemChanged" Margin="0,10,0,0">
                                <TreeView.Resources>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <HierarchicalDataTemplate DataType="{x:Type local:HistoryDateGroupViewModel}" ItemsSource="{Binding Records}">
                                        <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" />
                                    </HierarchicalDataTemplate>
                                    <DataTemplate DataType="{x:Type local:HistoryRecordViewModel}">
                                        <TextBlock Width="154" Margin="0,6,0,5" Text="{Binding TaskType}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="AI消息" FontSize="20" FontWeight="SemiBold" />
                        <Button x:Name="ReadAloudButton" Content="朗读" Click="ReadAloudButton_Click" Padding="10,6" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                        <Button Content="盘前" Tag="premarket" Click="AiAnchor_Click" Padding="9,4" />
                        <Button Content="M0" Tag="m0" Click="AiAnchor_Click" Padding="9,4" Margin="7,0,0,0" />
                        <Button Content="M1" Tag="m1" Click="AiAnchor_Click" Padding="9,4" Margin="7,0,0,0" />
                        <Button Content="M2" Tag="m2" Click="AiAnchor_Click" Padding="9,4" Margin="7,0,0,0" />
                        <Button Content="最新" Tag="latest" Click="AiAnchor_Click" Padding="9,4" Margin="7,0,0,0" />
                    </StackPanel>
                    <Border Grid.Row="2" Background="{StaticResource BorderBrush}" />
                    <ScrollViewer x:Name="AiTimelineScrollViewer" Grid.Row="3" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="AiTimelinePanel" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="我的消息" FontSize="20" FontWeight="SemiBold" />
                    <ScrollViewer x:Name="MyMessagesScrollViewer" Grid.Row="1" Margin="0,14,0,14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="MainJudgmentTimelinePanel" />
                    </ScrollViewer>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBox x:Name="MainJudgmentInputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" MaxHeight="160"
                                     TextChanged="MainJudgmentInputBox_TextChanged" VerticalScrollBarVisibility="Auto"
                                     ToolTip="文字只保存在当前判断草稿中；点击发送后进入待提交区。" />
                            <Canvas x:Name="WaveformCanvas" MinHeight="76" IsHitTestVisible="False" Visibility="Collapsed"
                                    Background="#E60E1726" ClipToBounds="True">
                                <Polyline x:Name="WaveformLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                            </Canvas>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="InputStatusText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="MainVoiceButton" Content="语音输入" Click="MainVoice_Click" Padding="10,6" />
                                <Button x:Name="MainSendButton" Content="发送" Click="MainSend_Click" Padding="10,6" Margin="8,0,0,0" IsEnabled="False" />
                                <Button x:Name="MainCommitButton" Content="提交 H0" Click="MainCommit_Click" Padding="10,6" Margin="8,0,0,0" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
