<Window x:Class="AITradingCompanion.Desktop.Views.PortfolioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="当前持仓" Width="920" Height="650" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}" />
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="8,9" CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1C2A41" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#223552" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="当前持仓" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button x:Name="UndoButton" Content="撤销最近更新" Click="UndoButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7" IsEnabled="False" />
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />
        <Grid Grid.Row="2" Margin="0,14,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="8,0,8,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="股票" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Grid.Column="1" Text="股数" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="成本" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="参考价" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="浮动盈亏" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" />
                </Grid>
                <ListView x:Name="PositionsList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Code}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SharesText}" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding CostText}" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding PriceText}" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding PnlText}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource BorderBrush}" />
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="最近变更" FontSize="16" FontWeight="SemiBold" />
            <ListBox x:Name="TransactionsList" Grid.Row="1" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}" Margin="0,5" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
