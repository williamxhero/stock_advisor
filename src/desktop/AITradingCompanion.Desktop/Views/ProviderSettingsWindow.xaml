<Window x:Class="AITradingCompanion.Desktop.Views.ProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运行时 Provider 与研究配置" Width="660" Height="650" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource PrimaryTextBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
    <TextBlock Text="CPA Provider" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="API key 仅写入 Windows 凭据库，配置文件不会保存密钥。保存后可通过运行时 probe 验证能力。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
    <TextBlock Text="Provider API URL"/><TextBox x:Name="ProviderUrl" Margin="0,4,0,10"/>
    <TextBlock Text="Windows 凭据目标"/><TextBox x:Name="CredentialTarget" Margin="0,4,0,10"/>
    <TextBlock Text="更新 API key（留空则不改）"/><PasswordBox x:Name="ApiKey" Margin="0,4,0,14"/>
    <TextBlock Text="研究模型 / effort"/><StackPanel Orientation="Horizontal" Margin="0,4,0,8"><TextBox x:Name="ResearchModel" Width="360"/><TextBox x:Name="ResearchEffort" Width="100" Margin="8,0,0,0"/></StackPanel>
    <TextBlock Text="判断模型 / effort"/><StackPanel Orientation="Horizontal" Margin="0,4,0,8"><TextBox x:Name="JudgmentModel" Width="360"/><TextBox x:Name="JudgmentEffort" Width="100" Margin="8,0,0,0"/></StackPanel>
    <TextBlock Text="快速模型 / effort"/><StackPanel Orientation="Horizontal" Margin="0,4,0,14"><TextBox x:Name="FastModel" Width="360"/><TextBox x:Name="FastEffort" Width="100" Margin="8,0,0,0"/></StackPanel>
    <TextBlock Text="小电脑 SearXNG URL"/><TextBox x:Name="SearxUrl" Margin="0,4,0,10"/>
    <TextBlock Text="Edge Profile 与专用 Profile 目录"/><StackPanel Orientation="Horizontal" Margin="0,4,0,10"><TextBox x:Name="EdgeProfile" Width="220"/><TextBox x:Name="BrowserProfileDirectory" Width="220" Margin="8,0,0,0"/></StackPanel>
    <TextBlock Text="下载上限（MB）"/><TextBox x:Name="DownloadLimit" Width="100" Margin="0,4,0,16"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Padding="14,6"/><Button Content="保存" IsDefault="True" Click="Save_Click" Padding="14,6" Margin="8,0,0,0"/></StackPanel>
  </StackPanel></ScrollViewer>
</Window>
