<Window x:Class="AITradingCompanion.Desktop.Views.ProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Provider 管理" Width="1180" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        Loaded="Window_Loaded">
  <Grid Margin="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="3">
      <TextBlock Text="Provider 工作台" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="端点倍率统一作用于该 Provider 的相对成本路由。密钥只会提交给本地运行时，读取列表不会返回它。" Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>
      <TextBox x:Name="SearchBox" TextChanged="FilterChanged" Padding="8,5" ToolTip="搜索 ID 或主机"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
        <ComboBox x:Name="StatusFilter" Width="140" SelectionChanged="FilterChanged"><ComboBoxItem Content="全部状态"/><ComboBoxItem Content="已启用"/><ComboBoxItem Content="已停用"/><ComboBoxItem Content="已归档"/></ComboBox>
        <ComboBox x:Name="SortFilter" Width="140" Margin="8,0,0,0" SelectionChanged="FilterChanged"><ComboBoxItem Content="更新时间"/><ComboBoxItem Content="倍率"/><ComboBoxItem Content="产品成功率"/></ComboBox>
      </StackPanel>
      <ListBox x:Name="ProviderList" DisplayMemberPath="Display" SelectionChanged="ProviderList_SelectionChanged"
               Height="410" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
      <WrapPanel Margin="0,12,0,0">
        <Button Content="新建" Click="New_Click" Padding="12,6"/>
        <Button Content="复制" Click="Copy_Click" Padding="12,6" Margin="8,0,0,0"/>
        <Button Content="探测" Click="Probe_Click" Padding="12,6" Margin="8,0,0,0"/>
      </WrapPanel>
      <WrapPanel Margin="0,8,0,0">
        <Button Content="归档" Click="Archive_Click" Padding="12,6"/>
        <Button Content="恢复" Click="Restore_Click" Padding="12,6" Margin="8,0,0,0"/>
        <Button Content="永久删除" Click="Delete_Click" Padding="12,6" Margin="8,0,0,0"/>
      </WrapPanel>
    </StackPanel>

    <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="3">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="普通阶段路由模式" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,14">
          <ComboBox x:Name="FamilyMode" Width="190"><ComboBoxItem Tag="auto" Content="自动竞技"/><ComboBoxItem Tag="openai" Content="仅 Codex / GPT"/><ComboBoxItem Tag="anthropic" Content="仅 Claude"/></ComboBox>
          <TextBlock Text="M1 始终使用 GPT + Claude 盲判，不受此开关影响。" Margin="12,5,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
      </StackPanel>
      <Grid Grid.Row="1" Margin="0,0,0,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Provider ID（创建后不可改）"/><TextBox x:Name="ProviderId" Margin="0,4,8,0"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="API 根地址或完整端点 URL"/><TextBox x:Name="ProviderUrl" Margin="0,4,8,0" ToolTip="Claude 使用 /chat/completions；Codex 自动改用 /responses。"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="倍率"/><TextBox x:Name="WeightBox" Margin="0,4,8,0"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="API key（留空保持原值）"/><PasswordBox x:Name="ApiKey" Margin="0,4,0,0"/><TextBlock x:Name="ApiKeyHint" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
        <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
          <Button Content="一键刷新模型" Click="RefreshModels_Click" Padding="12,5"/>
          <TextBlock x:Name="ModelsText" Margin="10,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
        </WrapPanel>
      </Grid>
      <StackPanel Grid.Row="2">
        <WrapPanel Margin="0,0,0,10">
          <CheckBox x:Name="OpenAiFamily" Content="Codex（Responses API）" Checked="FamilyChanged" Unchecked="FamilyChanged" Margin="0,0,20,0"/>
          <CheckBox x:Name="AnthropicFamily" Content="Claude（Chat Completions）" Checked="FamilyChanged" Unchecked="FamilyChanged" Margin="0,0,20,0"/>
          <CheckBox x:Name="EnabledBox" Content="启用 Provider" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" Margin="16,2,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
        </WrapPanel>
        <TextBlock Text="模型槽（自动 Tier 由模型官方价 × Provider 倍率计算；手动锁定不会被重算）" Margin="0,0,0,6" Foreground="{StaticResource SecondaryTextBrush}"/>
        <DataGrid x:Name="RoutesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" MinHeight="330" ItemsSource="{Binding Routes, RelativeSource={RelativeSource AncestorType=Window}}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="家族" Binding="{Binding Family}" IsReadOnly="True" Width="100"/>
            <DataGridTextColumn Header="槽" Binding="{Binding Slot}" IsReadOnly="True" Width="100"/>
            <DataGridTemplateColumn Header="模型" Width="*">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Model}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate><ComboBox IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding DataContext.AvailableModels, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Tier" Binding="{Binding Tier, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
            <DataGridComboBoxColumn Header="模式" SelectedItemBinding="{Binding TierMode, UpdateSourceTrigger=PropertyChanged}" Width="90">
              <DataGridComboBoxColumn.ItemsSource><x:Array Type="{x:Type sys:String}"><sys:String>auto</sys:String><sys:String>manual</sys:String></x:Array></DataGridComboBoxColumn.ItemsSource>
            </DataGridComboBoxColumn>
            <DataGridTextColumn Header="Preference" Binding="{Binding Preference, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
            <DataGridTextColumn Header="Effort" Binding="{Binding Effort, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="65"/>
          </DataGrid.Columns>
        </DataGrid>
        <Expander Header="模型目录（官方价格、别名与阶段能力）" Margin="0,12,0,0" Foreground="{StaticResource PrimaryTextBrush}">
          <StackPanel>
            <TextBlock Text="未校准模型不会伪造美元成本或能力分；缓存输入价留空时按普通输入价计。" Margin="0,4,0,6" Foreground="{StaticResource SecondaryTextBrush}"/>
            <DataGrid x:Name="CatalogGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="210" ItemsSource="{Binding ModelCatalog, RelativeSource={RelativeSource AncestorType=Window}}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="家族" Binding="{Binding Family}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="模型" Binding="{Binding Model}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="别名（逗号）" Binding="{Binding Aliases, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="输入 $/M" Binding="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                <DataGridTextColumn Header="缓存 $/M" Binding="{Binding CachedInput, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                <DataGridTextColumn Header="输出 $/M" Binding="{Binding Output, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                <DataGridTextColumn Header="研判/判断/快" Binding="{Binding Quality, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
              </DataGrid.Columns>
            </DataGrid>
            <Button Content="保存模型目录并重算自动 Tier" Click="SaveCatalog_Click" HorizontalAlignment="Right" Padding="12,5" Margin="0,8,0,0"/>
          </StackPanel>
        </Expander>
      </StackPanel>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="关闭" IsCancel="True" Padding="14,6"/>
        <Button Content="查看变更并保存" Click="Save_Click" IsDefault="True" Padding="14,6" Margin="8,0,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
