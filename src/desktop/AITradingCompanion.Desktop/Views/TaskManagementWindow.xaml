<Window x:Class="AITradingCompanion.Desktop.Views.TaskManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务管理" Width="1000" Height="650" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}" />
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0E1726" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
                <ToggleButton x:Name="ToggleButton" Background="#0E1726" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><Grid><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center" TextElement.Foreground="{StaticResource PrimaryTextBrush}" /><Path Data="M 0 0 L 6 6 L 12 0 Z" Fill="{StaticResource SecondaryTextBrush}" Width="12" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide"><Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,3,0,0"><ScrollViewer Background="{StaticResource CardBrush}" MaxHeight="260" CanContentScroll="True"><ItemsPresenter /></ScrollViewer></Border></Popup>
            </Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#273B59" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#223552" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#0E1726" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#0E1726" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="Calendar">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="CalendarItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="CalendarButton">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#273B59" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#273B59" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#223552" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="2" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#223552" /></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <StackPanel><TextBlock Text="任务管理" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="管理未来触发规则；不会改变已有判断" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" /></StackPanel>
            <Button Content="＋ 新建任务" Click="NewTask_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7" />
        </Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,15,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="任务列表" FontWeight="SemiBold" Margin="0,0,0,8" /><ListBox x:Name="TaskList" Grid.Row="1" SelectionChanged="TaskList_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,7"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="12,2,0,0" /></StackPanel><TextBlock Text="{Binding Next}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,3,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
            <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />
            <Border Grid.Column="2" Margin="20,0,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,16,18,18">
                <TextBlock Text="名称" /><TextBox x:Name="NameBox" Margin="0,5,0,12" />
                <TextBlock Text="任务内容" /><ComboBox x:Name="WorkflowBox" SelectedValuePath="Tag" SelectionChanged="WorkflowBox_SelectionChanged" Margin="0,5,0,2"><ComboBoxItem Tag="companion_judgment" Content="伴生研判" /><ComboBoxItem Tag="periodic_review" Content="定期复盘" /></ComboBox><TextBlock x:Name="WorkflowValueText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="2,0,0,12" />
                <TextBlock Text="触发类型" /><ComboBox x:Name="TriggerBox" SelectedValuePath="Tag" SelectionChanged="TriggerBox_SelectionChanged" Margin="0,5,0,2"><ComboBoxItem Tag="trading_day_fixed" Content="交易日固定时间" /><ComboBoxItem Tag="market_relative" Content="开收盘相对时间" /><ComboBoxItem Tag="calendar_periodic" Content="日历周期" /><ComboBoxItem Tag="once" Content="单次任务" /></ComboBox><TextBlock x:Name="TriggerValueText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="2,0,0,12" />
                <TextBlock x:Name="TriggerHint" Foreground="{StaticResource SecondaryTextBrush}" Text="触发时间" /><StackPanel x:Name="TimePickerPanel" Orientation="Horizontal" Margin="0,5,0,12"><ComboBox x:Name="HourBox" Width="72" /><TextBlock Text=":" Margin="8,6" Foreground="{StaticResource SecondaryTextBrush}" /><ComboBox x:Name="MinuteBox" Width="72" /></StackPanel>
                <StackPanel x:Name="OnceDatePanel" Visibility="Collapsed" Margin="0,0,0,12"><TextBlock Text="触发日期" /><DatePicker x:Name="OnceDatePicker" Margin="0,5,0,0" SelectedDateFormat="Short" /></StackPanel>
                <TextBlock Text="生效范围" /><StackPanel Orientation="Horizontal" Margin="0,5,0,12"><StackPanel><DatePicker x:Name="StartDatePicker" Width="150" SelectedDateFormat="Short" /><TextBlock Text="不选则立即生效" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="2,3,0,0" /></StackPanel><TextBlock Text="至" Margin="10,6" Foreground="{StaticResource SecondaryTextBrush}" /><StackPanel><DatePicker x:Name="EndDatePicker" Width="150" SelectedDateFormat="Short" /><TextBlock Text="不选则长期有效" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="2,3,0,0" /></StackPanel></StackPanel>
                <TextBlock Text="备注（可选）" /><TextBox x:Name="NoteBox" Margin="0,5,0,12" AcceptsReturn="True" Height="54" TextWrapping="Wrap" />
                <TextBlock Text="系统识别" FontWeight="SemiBold" Margin="0,6,0,3" /><TextBlock x:Name="PreviewText" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button x:Name="ArchiveButton" Content="归档任务" Click="ArchiveButton_Click" Padding="12,7" /><Button x:Name="PauseButton" Content="停用任务" Click="PauseButton_Click" Padding="12,7" Margin="10,0,0,0" /><Button x:Name="SaveButton" Content="保存修改" Click="SaveButton_Click" Padding="12,7" Margin="10,0,0,0" /></StackPanel>
            </StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</Window>
