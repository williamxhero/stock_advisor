<Window x:Class="AITradingCompanion.ToolManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据工具管理" Width="920" Height="620" MinWidth="720" MinHeight="450">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel><StackPanel><TextBlock Text="数据工具管理" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Foreground="Gray"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="暂停" Padding="14,6" Click="Pause_Click"/><Button Content="重试" Padding="14,6" Margin="8,0,0,0" Click="Retry_Click"/><Button Content="禁用工具" Padding="14,6" Margin="8,0,0,0" Click="Disable_Click"/><Button Content="回滚" Padding="14,6" Margin="8,0,0,0" Click="Rollback_Click"/><Button Content="刷新" Padding="14,6" Margin="8,0,0,0" Click="Refresh_Click"/></StackPanel></DockPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Header="能力需求与开发状态"><DataGrid x:Name="NeedsGrid" IsReadOnly="True" AutoGenerateColumns="True"/></GroupBox>
      <GroupBox Grid.Column="2" Header="正式工具、健康与审计"><DataGrid x:Name="ToolsGrid" IsReadOnly="True" AutoGenerateColumns="True"/></GroupBox>
    </Grid>
  </Grid>
</Window>
