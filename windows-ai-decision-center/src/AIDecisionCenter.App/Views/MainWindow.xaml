<Window x:Class="AIDecisionCenter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A股 AI Decision Center"
        Icon="/Assets/app-icon.ico"
        Width="1180" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="A股 AI Decision Center" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TodayText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,6,0,0" />
                <TextBlock Text="{Binding LatestReplyText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#152F32" BorderBrush="#285D56" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Button Content="立即扫描" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                <Button Content="运行目录" Command="{Binding OpenConfigCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                <TabControl SelectedIndex="{Binding SelectedSectionIndex}" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Header" Background="Transparent" CornerRadius="8" Padding="11,7">
                                            <ContentPresenter ContentSource="Header" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Header" Property="Background" Value="#223552" />
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Header" Property="Background" Value="#1C2A41" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="RecordListItemStyle" TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,9" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Container" Background="{TemplateBinding Background}" CornerRadius="10" Padding="13,12">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Container" Property="Background" Value="#1C2A41" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Container" Property="Background" Value="#223552" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem>
                        <TabItem.Header>
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <Run Text="今日节点  " /><Run Text="{Binding CompletedCount, Mode=OneWay}" /><Run Text="/5" />
                            </TextBlock>
                        </TabItem.Header>
                        <ListBox Margin="0,14,0,0" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RecordListItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource BlueBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Width="52" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource BlueBrush}" Margin="0,0,7,0"
                                                     Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="✓" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold"
                                                       Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Right" />
                                            <TextBlock Text="PASS" Foreground="#E6B85C" FontSize="10" FontWeight="SemiBold"
                                                       Visibility="{Binding IsPassed, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <Run Text="历史消息  " /><Run Text="{Binding HistoryCount, Mode=OneWay}" />
                            </TextBlock>
                        </TabItem.Header>
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索任务、摘要、正文、备注或task_key" />
                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Padding="6" />
                                <WrapPanel Margin="0,6,0,0">
                                    <CheckBox Content="仅未读" IsChecked="{Binding UnreadOnly}" Margin="0,0,12,0" />
                                    <CheckBox Content="仅收藏" IsChecked="{Binding StarredOnly}" Margin="0,0,12,0" />
                                    <CheckBox Content="含归档" IsChecked="{Binding IncludeArchived}" />
                                </WrapPanel>
                            </StackPanel>
                            <ListBox Grid.Row="2" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}"
                                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RecordListItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TaskType}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="  ★" FontSize="14" Foreground="#E6B85C"
                                                               Visibility="{Binding IsStarred, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CategoryText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource BlueBrush}" Margin="0,0,7,0"
                                                         Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding ReceivedAtText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding DetailTitle}" FontSize="20" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,16">
                                <TextBlock Text="{Binding DetailSlotText}" Foreground="{StaticResource BlueBrush}" />
                                <TextBlock Text="  ·  " Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding DetailReceivedAtText}" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="  ·  " Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding DetailCategoryText}" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="{Binding ReadButtonText}" Command="{Binding ToggleReadCommand}" Margin="0,0,6,0" Padding="10,6" />
                            <Button Content="{Binding StarButtonText}" Command="{Binding ToggleStarredCommand}" Margin="0,0,6,0" Padding="10,6" />
                            <Button Content="{Binding ArchiveButtonText}" Command="{Binding ToggleArchivedCommand}" Margin="0,0,6,0" Padding="10,6" />
                            <Button Content="导出" Command="{Binding ExportCommand}" Padding="10,6" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />
                    <FlowDocumentScrollViewer x:Name="MarkdownViewer" Grid.Row="3" Background="Transparent" BorderThickness="0"
                                              VerticalScrollBarVisibility="Auto" IsSelectionEnabled="True" />
                    <StackPanel Grid.Row="4" Margin="0,14,0,0">
                        <TextBlock Text="个人备注（不会改写AI原文）" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="保存备注" Command="{Binding SaveNoteCommand}" Margin="8,0,0,0" Padding="10,6" />
                            <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" />
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="5" Text="AI原文不可编辑；已读、收藏、归档和备注保存在Decision Center本地SQLite。"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button HorizontalAlignment="Right" Command="{Binding ToggleStartupCommand}" Padding="12,6">
                <TextBlock>
                    <Run Text="开机启动：" /><Run Text="{Binding StartupStateText, Mode=OneWay}" />
                </TextBlock>
            </Button>
        </Grid>
    </Grid>
</Window>
